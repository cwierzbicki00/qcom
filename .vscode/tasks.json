{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Launch OpenOCD",
            "type": "shell",
            "command": "${workspaceRoot}/tools/openocd/openocd",
            "args": [
                "-f", "${workspaceRoot}/tools/openocd/interface/ch347.cfg",
                "-f", "${workspaceRoot}/tools/openocd/target/tgt_qcc74x.cfg"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^.+$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^Open On-Chip Debugger",
                    "endsPattern": "Info : Listening on port 3333 for gdb connections"
                }
            }
    
        },
        {
            "label": "Terminate OpenOCD",
            "type": "shell",
            "command": "taskkill",
            "args": ["/IM", "openocd.exe", "/F"],
            "problemMatcher": []
        }
    ]
}

void mbedtls_net_close( mbedtls_net_context *ctx )
{
    if( ctx->fd == -1 )
        return;

    lwip_close(ctx->fd);

    ctx->fd = -1;
}




void mbedtls_net_free( mbedtls_net_context *ctx )
{
    if( ctx->fd == -1 )
        return;

    lwip_shutdown(ctx->fd,2);
    lwip_close(ctx->fd);

    ctx->fd = -1;
}

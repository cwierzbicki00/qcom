 case HOSTAPD_MODE_IEEE80211G:
  return PHY_TYPE_ERP;
 case HOSTAPD_MODE_IEEE80211AD:
  return PHY_TYPE_DMG;
 default:
  return PHY_TYPE_UNSPECIFIED;
 };
}




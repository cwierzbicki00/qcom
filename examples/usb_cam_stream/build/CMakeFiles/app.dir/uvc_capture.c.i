static int cmd_cam_start(int argc, char **argv)
{
    (void)argc; (void)argv;

    if (!g_video_class) {
        printf("No camera attached\r\n");
        return -1;
    }

    if (g_cam_state == CAMERA_STREAMING) {
        printf("Camera already streaming\r\n");
        return 0;
    }

    if (g_cam_state != CAMERA_ATTACHED) {

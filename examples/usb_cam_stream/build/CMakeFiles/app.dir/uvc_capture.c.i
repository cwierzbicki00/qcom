    printf("\033[0m[I][" "UVC" "] " "[UVC] Selected MJPEG %ux%u  altsetting=%u (MPS=%u, cap=%u)\r\n", w, h, alt, alt_mps, (unsigned)800U)
                                                        ;



    g_preferred_interval_100ns = (10000000U / 10U);
    video_class->probe.hintUnion.bmHint = 0x01;
    video_class->probe.hintUnion1.bmHint = 0x01;
    video_class->probe.dwFrameInterval = g_preferred_interval_100ns;
    printf("\033[0m[I][" "UVC" "] " "[UVC] Requesting frame interval=%u (100ns) (~%u fps target)\r\n", (unsigned)g_preferred_interval_100ns, (unsigned)10U)

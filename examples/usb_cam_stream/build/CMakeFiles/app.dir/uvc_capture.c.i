    int ret = usbh_video_open(video_class, 1, w, h, alt);
    if (ret < 0) {

        printf("\033[0;33m[W][" "UVC" "] " "[UVC] usbh_video_open failed with forced interval (%u): %d, retrying auto interval\r\n", (unsigned)g_preferred_interval_100ns, ret)
                                                        ;
        g_preferred_interval_100ns = 0U;

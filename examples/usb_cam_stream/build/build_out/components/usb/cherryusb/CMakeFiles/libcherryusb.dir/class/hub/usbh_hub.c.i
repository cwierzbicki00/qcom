static void usbh_hub_thread(void *argument)
{
    struct usbh_hub *hub;
    int ret = 0;

    struct usbh_bus *bus = (struct usbh_bus *)((uintptr_t)argument);

    usb_hc_init(bus);
    while (1) {
        ret = usb_osal_mq_recv(bus->hub_mq, (uintptr_t *)&hub, (0xFFFFFFFFU));
        if (ret < 0) {
            continue;
        }
        usbh_hub_events(hub);
    }
}

void usbh_hub_thread_wakeup(struct usbh_hub *hub)
{

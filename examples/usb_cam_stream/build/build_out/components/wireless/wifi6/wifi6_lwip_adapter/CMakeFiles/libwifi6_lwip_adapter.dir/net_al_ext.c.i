static int wifi_sta_dhcpc_stop(uint8_t fhost_vif_idx)
{
    struct net_al_ext_ip_addr_cfg ip_cfg;
    ip_cfg.mode = IP_ADDR_NONE;
    if (net_al_ext_set_vif_ip(fhost_vif_idx, &ip_cfg)) {
        printf("dhcpc stop error\n");
        return -1;
    }
    return 0;
}


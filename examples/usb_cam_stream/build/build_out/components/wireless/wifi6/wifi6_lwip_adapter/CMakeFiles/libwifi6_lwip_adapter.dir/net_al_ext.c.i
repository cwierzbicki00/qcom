    net_al_if_t net_if;

    net_if = fhost_to_net_if(fvif_idx);
    do { if (!(net_if)) { dbg_assert_err(".\\components\\wireless\\wifi6\\wifi6_lwip_adapter\\net_al_ext.c", 231); } } while(0);

    if (MGMR_VIF_AP == fvif_idx)

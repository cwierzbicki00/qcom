static __attribute__((__always_inline__)) inline uint8_t co_val_get(uint8_t const array[], int lsb, int width)
{
    int msb = lsb + width - 1;
    int l_byte_idx = lsb/8;
    int m_byte_idx = msb/8;
    uint8_t val;

    if (m_byte_idx == l_byte_idx)
    {
        uint8_t mask = (1UL<<(width)) - 1;
        int shift = lsb % 8;
        val = (array[l_byte_idx] >> shift) & mask;
    }
    else
    {
        uint8_t l_bits_cnt = m_byte_idx * 8 - lsb;
        uint8_t l_mask = (1UL<<(l_bits_cnt)) - 1;
        uint8_t m_mask = (1UL<<(width - l_bits_cnt)) - 1;
        int l_shift = lsb % 8;
        val = (array[l_byte_idx] >> l_shift) & l_mask;
        val |= (array[m_byte_idx] & m_mask) << l_bits_cnt;
    }

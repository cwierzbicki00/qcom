static inline int wpa_key_mgmt_wpa_ieee8021x(int akm)
{
 return !!(akm & ((1U << (0)) |
    (1U << (5)) |
    (1U << (24)) |
    (1U << (14)) |
    (1U << (15)) |
    (1U << (7)) |
    (1U << (16)) |
    (1U << (17)) |
    (1U << (18)) |
    (1U << (19)) |
    (1U << (20)) |
    (1U << (21))));
}

static inline int wpa_key_mgmt_wpa_psk_no_sae(int akm)
{
 return !!(akm & ((1U << (1)) |
    (1U << (6)) |
    (1U << (8))));
}

static inline int wpa_key_mgmt_wpa_psk(int akm)
{
 return !!(akm & ((1U << (1)) |
    (1U << (6)) |
    (1U << (8)) |
    (1U << (10)) |
    (1U << (11))));
}

static inline int wpa_key_mgmt_ft(int akm)
{
 return !!(akm & ((1U << (6)) | (1U << (5)) | (1U << (24)) | (1U << (11)) | (1U << (20)) | (1U << (21))));
}

static inline int wpa_key_mgmt_only_ft(int akm)
{
 int ft = wpa_key_mgmt_ft(akm);
 akm &= ~((1U << (6)) | (1U << (5)) | (1U << (24)) | (1U << (11)) | (1U << (20)) | (1U << (21)));
 return ft && !akm;
}

static inline int wpa_key_mgmt_ft_psk(int akm)
{
 return !!(akm & (1U << (6)));
}

static inline int wpa_key_mgmt_sae(int akm)
{
 return !!(akm & ((1U << (10)) |
    (1U << (11))));
}

static inline int wpa_key_mgmt_fils(int akm)
{
 return !!(akm & ((1U << (18)) |
    (1U << (19)) |
    (1U << (20)) |
    (1U << (21))));
}

static inline int wpa_key_mgmt_sha256(int akm)
{
 return !!(akm & ((1U << (8)) |
    (1U << (7)) |
    (1U << (10)) |
    (1U << (11)) |
    (1U << (15)) |
    (1U << (16)) |
    (1U << (18)) |
    (1U << (20))));
}

static inline int wpa_key_mgmt_sha384(int akm)
{
 return !!(akm & ((1U << (17)) |
    (1U << (24)) |
    (1U << (19)) |
    (1U << (21))));
}

static inline int wpa_key_mgmt_suite_b(int akm)
{
 return !!(akm & ((1U << (16)) |
    (1U << (17))));
}

static inline int wpa_key_mgmt_wpa(int akm)
{
 return wpa_key_mgmt_wpa_ieee8021x(akm) ||
  wpa_key_mgmt_wpa_psk(akm) ||
  wpa_key_mgmt_fils(akm) ||
  wpa_key_mgmt_sae(akm) ||
  akm == (1U << (22)) ||
  akm == (1U << (23));
}

static inline int wpa_key_mgmt_wpa_any(int akm)
{
 return wpa_key_mgmt_wpa(akm) || (akm & (1U << (4)));
}

static inline int wpa_key_mgmt_cckm(int akm)
{

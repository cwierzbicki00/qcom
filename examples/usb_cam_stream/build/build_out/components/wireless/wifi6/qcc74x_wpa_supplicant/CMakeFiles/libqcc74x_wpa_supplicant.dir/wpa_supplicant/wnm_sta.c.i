void ieee802_11_rx_wnm_action(struct wpa_supplicant *wpa_s,
         const struct ieee80211_mgmt *mgmt, size_t len)
{
 const u8 *pos, *end;
 u8 act;

 if (len < (sizeof(struct ieee80211_hdr)) + 2)
  return;

 pos = ((const u8 *) mgmt) + (sizeof(struct ieee80211_hdr)) + 1;
 act = *pos++;
 end = ((const u8 *) mgmt) + len;

 do { } while (0)
                            ;
 if (wpa_s->wpa_state < WPA_ASSOCIATED ||
     os_memcmp(mgmt->sa, wpa_s->bssid, 6) != 0) {
  do { } while (0)
              ;
  return;
 }

 switch (act) {
 case WNM_BSS_TRANS_MGMT_REQ:
  ieee802_11_rx_bss_trans_mgmt_req(wpa_s, pos, end,
       !(mgmt->da[0] & 0x01));
  break;
 case WNM_SLEEP_MODE_RESP:
  ieee802_11_rx_wnmsleep_resp(wpa_s, pos, end - pos);
  break;
 case WNM_NOTIFICATION_REQ:
  ieee802_11_rx_wnm_notif_req(wpa_s, mgmt->sa, pos, end - pos);
  break;
 case WNM_COLLOCATED_INTERFERENCE_REQ:
  ieee802_11_rx_wnm_coloc_intf_req(wpa_s, mgmt->sa, pos,
       end - pos);
  break;
 default:
  do { } while (0);
  break;
 }
}



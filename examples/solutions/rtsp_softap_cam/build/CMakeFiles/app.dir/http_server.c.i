static void snapshot_log_hex(const char *tag, const uint8_t *buf, uint32_t len)
{
    char hex[(96U * 2U) + 1U];
    uint32_t dump_len = len;
    uint32_t pos = 0U;

    if (!tag) {
        tag = "buf";
    }

    if (!buf || len == 0U) {
        printf("\033[0m[I][" "HTTP" "] " "[HTTP][RAW] %s len=%u data=<empty>\r\n", tag, (unsigned)len);
        return;
    }

    if (dump_len > 96U) {
        dump_len = 96U;
    }

    for (uint32_t i = 0U; i < dump_len; i++) {
        static const char h[] = "0123456789ABCDEF";
        uint8_t b = buf[i];
        hex[pos++] = h[(b >> 4) & 0x0FU];
        hex[pos++] = h[b & 0x0FU];
    }
    hex[pos] = '\0';

    printf("\033[0m[I][" "HTTP" "] " "[HTTP][RAW] %s len=%u dump=%u data=%s%s\r\n", tag, (unsigned)len, (unsigned)dump_len, hex, (dump_len < len) ? "..." : "")

                                        ;
}


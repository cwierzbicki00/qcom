static int recv_request_line(int sock, char *buf, int buf_len)
{
    int n = 0;

    while (n < (buf_len - 1)) {
        int r = lwip_recv(sock,buf + n,(size_t)(buf_len - 1 - n),0);
        if (r <= 0) {
            return (n > 0) ? n : r;
        }

        n += r;
        buf[n] = '\0';
        if (strstr(buf, "\r\n") || strchr(buf, '\n')) {
            break;
        }
    }

    return n;
}


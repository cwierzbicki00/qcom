            if ((recv_len = lwip_ping_recv(s, &ttl)) >= 0) {
                recv_times++;
                elapsed_time = (sys_now() - recv_start_tick) * 1000UL / (1000 * ( ( TickType_t ) 1000 / ((TickType_t)1000) ));
                printf("%d bytes from %s icmp_seq=%d ttl=%d time=%d ms\n\r", recv_len, ip4addr_ntoa((const ip4_addr_t*)&(ina)), send_times,
                       ttl, elapsed_time);
            } else {
                printf("From %s icmp_seq=%d timeout\n\r", ip4addr_ntoa((const ip4_addr_t*)&(ina)), send_times);
            }
        } else {
            printf("Send %s - error\n\r", ip4addr_ntoa((const ip4_addr_t*)&(ina)));
        }

        send_times++;
        if (send_times >= count) {

            break;
        }

        vTaskDelay(interval);
    }

    lwip_close(s);
    printf("Ping Done. Statistic is: %lu sent %lu received\n", send_times, recv_times);

    return 0;
}



static __attribute__((__always_inline__)) inline int phy_freq_to_channel(uint8_t band, uint16_t freq)
{
    if ((band == PHY_BAND_2G4) && (freq >= 2412) && (freq <= 2484))
    {
        if (freq == 2484)
            return 14;
        else
            return (freq - 2407) / 5;
    }
    else if ((band == PHY_BAND_5G) && (freq >= 5005) && (freq <= 5885))
    {
        return (freq - 5000) / 5;
    }

    return 0;
}
# 230 "C:\\Users\\cwier\\Documents\\GitHub\\qcom\\components\\wireless\\qcc74x_macsw\\include/export/phy.h"
static __attribute__((__always_inline__)) inline uint16_t phy_channel_to_freq(uint8_t band, int channel)
{
    if ((band == PHY_BAND_2G4) && (channel >= 1) && (channel <= 14))
    {
        if (channel == 14)
            return 2484;
        else
            return 2407 + channel * 5;
    }
    else if ((band == PHY_BAND_5G) && (channel >= 1) && (channel <= 177))
    {
        return 5000 + channel * 5;
    }

    return 0;
}








static void eapol_port_timers_tick(void *eloop_ctx, void *timeout_ctx)
{
 struct eapol_sm *sm = timeout_ctx;

 if (sm->authWhile > 0) {
  sm->authWhile--;
  if (sm->authWhile == 0)
   do { } while (0);
 }
 if (sm->heldWhile > 0) {
  sm->heldWhile--;
  if (sm->heldWhile == 0)
   do { } while (0);
 }
 if (sm->startWhen > 0) {
  sm->startWhen--;
  if (sm->startWhen == 0)
   do { } while (0);
 }
 if (sm->idleWhile > 0) {
  sm->idleWhile--;
  if (sm->idleWhile == 0)
   do { } while (0);
 }

 if (sm->authWhile | sm->heldWhile | sm->startWhen | sm->idleWhile) {
  if (eloop_register_timeout(1, 0, eapol_port_timers_tick,
        eloop_ctx, sm) < 0)
   sm->timer_tick_enabled = 0;
 } else {
  do { } while (0);
  sm->timer_tick_enabled = 0;
 }
 eapol_sm_step(sm);
}



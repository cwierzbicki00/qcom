    ((key_flag & (KEY_FLAG_PAIRWISE | KEY_FLAG_MODIFY)) &&
     (key_flag & ~KEY_FLAG_PAIRWISE_MASK)) ||
    ((key_flag & KEY_FLAG_GROUP) &&
     (key_flag & ~KEY_FLAG_GROUP_MASK)) ||
    ((key_flag & KEY_FLAG_PMK) &&
     (key_flag & ~KEY_FLAG_PMK_MASK)));
}


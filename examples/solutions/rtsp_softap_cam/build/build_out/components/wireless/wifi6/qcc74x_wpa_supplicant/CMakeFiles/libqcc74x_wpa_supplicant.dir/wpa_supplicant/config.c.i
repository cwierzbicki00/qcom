static inline int os_time_before(struct os_time *a, struct os_time *b)
{
 return (a->sec < b->sec) ||
        (a->sec == b->sec && a->usec < b->usec);
}


static inline void os_time_sub(struct os_time *a, struct os_time *b,
          struct os_time *res)
{
 res->sec = a->sec - b->sec;
 res->usec = a->usec - b->usec;
 if (res->usec < 0) {
  res->sec--;
  res->usec += 1000000;
 }
}





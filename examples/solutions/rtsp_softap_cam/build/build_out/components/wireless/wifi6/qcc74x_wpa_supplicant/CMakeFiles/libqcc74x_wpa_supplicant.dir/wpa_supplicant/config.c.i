static inline int wpabuf_cmp(const struct wpabuf *a, const struct wpabuf *b)
{
 if (!a && !b)
  return 0;
 if (a && b && wpabuf_size(a) == wpabuf_size(b))
  return os_memcmp(a->buf, b->buf, wpabuf_size(a));

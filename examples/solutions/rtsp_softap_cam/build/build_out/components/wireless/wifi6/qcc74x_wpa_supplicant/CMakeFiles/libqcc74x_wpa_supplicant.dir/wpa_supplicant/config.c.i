 size_t i;

 for (i = 0; i < (sizeof(global_fields) / sizeof((global_fields)[0])); i++) {
  const struct global_parse_data *field = &global_fields[i];
  int tmp;

  if (!field->get)
   continue;

  tmp = field->get(field->name, config, (long) field->param1,
     buf, buflen, 1);
  if (tmp < 0)
   return -1;
  buf += tmp;
  buflen -= tmp;
  result += tmp;
 }
 return result;
}



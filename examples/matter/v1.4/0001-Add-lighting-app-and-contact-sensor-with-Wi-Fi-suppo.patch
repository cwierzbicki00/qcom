+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import("//build_overrides/build.gni")
+import("//build_overrides/chip.gni")
+import("//build_overrides/qcc74x_sdk.gni")
+
+import("${build_root}/toolchain/gcc_toolchain.gni")
+import("${chip_root}/src/platform/device.gni")
+
+template("riscv_toolchain") {
+  gcc_toolchain(target_name) {
+
+    ar = invoker.qcc74x_sdk_toolchain + "/riscv64-unknown-elf-ar"
+    cc = invoker.qcc74x_sdk_toolchain + "/riscv64-unknown-elf-gcc"
+    cxx = invoker.qcc74x_sdk_toolchain + "/riscv64-unknown-elf-g++"
+
+    toolchain_args = {
+      current_cpu = "riscv"
+      current_os = invoker.current_os
+      is_clang = false
+
+      forward_variables_from(invoker.toolchain_args, "*")
+    }
+  }
+}

diff --git a/scripts/build/builders/qcc74x.py b/scripts/build/builders/qcc74x.py
new file mode 100644
index 0000000000..e0b48d1500
--- /dev/null
+++ b/scripts/build/builders/qcc74x.py
@@ -0,0 +1,211 @@
+# Copyright (c) 2021 Project CHIP Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+# http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import logging
+import os
+import time
+import re
+
+from enum import Enum, auto
+from pathlib import Path
+
+from .builder import BuilderOutput
+from .gn import GnBuilder
+
+SDK_VERSION_MAJOR = 2
+SDK_VERSION_MINOR = 0
+SDK_VERSION_PATCH = 69
+
+class Qcc74xApp(Enum):
+    LIGHT = auto()
+    CONTACT = auto()
+
+    def ExampleName(self):
+        if self == Qcc74xApp.LIGHT:
+            return 'lighting-app'
+        elif self == Qcc74xApp.CONTACT:
+            return 'contact-sensor-app'
+        else:
+            raise Exception('Unknown app type: %r' % self)
+
+    def AppNamePrefix(self, chip_name):
+        if self == Qcc74xApp.LIGHT:
+            return ('chip-%s-lighting-example' % chip_name)
+        elif self == Qcc74xApp.CONTACT:
+            return ('chip-%s-contact-sensor-example' % chip_name)
+        else:
+            raise Exception('Unknown app type: %r' % self)
+
+
+class Qcc74xBoard(Enum):
+    QCC743DK = auto()
+    QCC744DK = auto()
+
+    def GnArgName(self):
+
+        if self == Qcc74xBoard.QCC743DK:
+            return 'qcc743dk'
+        elif self == Qcc74xBoard.QCC744DK:
+            return 'qcc744dk'
+        else:
+            raise Exception('Unknown board #: %r' % self)
+
+
+class Qcc74xBuilder(GnBuilder):
+
+    def __init__(self,
+                 root,
+                 runner,
+                 app: Qcc74xApp = Qcc74xApp.LIGHT,
+                 board: Qcc74xBoard = Qcc74xBoard.QCC743DK,
+                 enable_wifi: bool = False,
+                 enable_mfd: bool = False,
+                 enable_rotating_device_id: bool = False,
+                 enable_shell: bool = False,
+                 enable_heap_monitoring: bool = False,
+                 enable_debug_coredump: bool = False,
+                 ):
+
+        super(Qcc74xBuilder, self).__init__(
+            root=os.path.join(root, 'examples',
+                              app.ExampleName(), 'qualcomm', 'qcc74x'),
+            runner=runner
+        )
+
+        qcc74x_board=board.GnArgName()
+        qcc74x_sdk_root, qcc74x_sdk_toolchain = self.verify_sdk_variables()
+        enable_thread = False
+        chip_mdns = "minimal"
+
+        self.argsOpt = []
+        self.app = app
+
+        self.argsOpt.append(f'qcc74x_board="{qcc74x_board}"')
+        self.argsOpt.append(f'chip_enable_wifi={str(enable_wifi).lower()}')
+        self.argsOpt.append(f'chip_enable_openthread={str(enable_thread).lower()}')
+        self.argsOpt.append(f'chip_config_network_layer_ble=true')
+
+        self.argsOpt.append(f'chip_mdns="{chip_mdns}"')
+        self.argsOpt.append(f'chip_inet_config_enable_ipv4={str(enable_wifi).lower()}')
+
+        if enable_shell:
+            self.argsOpt.append('chip_build_libshell=true')
+
+        if enable_rotating_device_id:
+            self.argsOpt.append('chip_enable_additional_data_advertising=true')
+            self.argsOpt.append('chip_enable_rotating_device_id=true')
+
+        if enable_mfd:
+            self.argsOpt.append("chip_enable_factory_data=true")
+
+        self.argsOpt.append(f"enable_heap_monitoring={str(enable_heap_monitoring).lower()}")
+        if enable_debug_coredump:
+            self.argsOpt.append(f"enable_debug_coredump=true")
+            self.argsOpt.append(f"coredump_binary_id={int(time.time())}")
+
+        self.argsOpt.append(f"chip_generate_link_map_file=true")
+
+        self.argsOpt.append(f'qcc74x_sdk_root="%s"' % qcc74x_sdk_root)
+        self.argsOpt.append(f'qcc74x_sdk_toolchain="%s"' % qcc74x_sdk_toolchain)
+        self.argsOpt.append(f'qcc74x_sdk_boot2="%s"' % self.search_boot2(qcc74x_sdk_root, qcc74x_board))
+        self.argsOpt.append(f'qcc74x_sdk_dts="%s"' % self.search_dts(qcc74x_sdk_root, qcc74x_board))
+        self.argsOpt.append(f'custom_toolchain="//third_party/connectedhomeip/config/qualcomm/qcc74x_toolchain:riscv_gcc"')
+
+    def verify_sdk_variables(self):
+        qcc74x_sdk_root=os.environ['QCC74X_SDK_ROOT']
+        qcc74x_sdk_toolchain=os.environ['QCC74X_SDK_TOOLCHAIN']
+
+        if "" == qcc74x_sdk_root or not os.path.exists(qcc74x_sdk_root) or not os.path.isdir(qcc74x_sdk_root):
+            raise Exception("Please export QCC74X_SDK_ROOT for qcc74x SDK.")
+        if "" == qcc74x_sdk_toolchain or not os.path.exists(qcc74x_sdk_toolchain) or not os.path.isdir(qcc74x_sdk_toolchain):
+            raise Exception("Please export QCC74X_SDK_TOOLCHAIN for qcc74x SDK toolchain.")
+
+        sdk_version_path=os.path.join(qcc74x_sdk_root, 'VERSION')
+        version_str = ""
+
+        try:
+            with open(sdk_version_path, "r") as ver_file:
+                version_str = ver_file.read()
+
+            match = re.search(r'(\d+)\.(\d+)\.(\d+)', version_str)
+            if not match:
+                raise Exception()
+        except Exception:
+            raise Exception("Please invalid qcc74x SDK path exported on QCC74X_SDK_ROOT.")
+
+        major, minor, patch = map(int, match.groups())
+        if not (SDK_VERSION_MAJOR == major) or not (SDK_VERSION_MINOR == minor) or patch < SDK_VERSION_PATCH:
+            raise Exception(f"{version_str} is not expected QCC74x SDK version.")
+
+        return qcc74x_sdk_root, qcc74x_sdk_toolchain
+
+    def search_boot2(self, qcc74x_sdk_root, qcc74x_board):
+
+        try:
+            board_path=os.path.join(qcc74x_sdk_root, 'bsp/board', qcc74x_board, "config")
+            boot2_file = sorted([str(path) for path in Path(board_path).glob("boot2_qcc743_isp_release*.bin")])[-1]
+        except Exception:
+            raise Exception("boot2 file is not found.")
+
+        return boot2_file
+
+    def search_dts(self, qcc74x_sdk_root, qcc74x_board):
+
+        try:
+            board_path=os.path.join(qcc74x_sdk_root, 'bsp/board', qcc74x_board, "config")
+            dts_file = sorted([str(path) for path in Path(board_path).glob("qcc74x_factory_params_IoTKitA_auto.dts")])[-1]
+        except Exception:
+            raise Exception("dts file is not found.")
+
+        return dts_file
+
+    def GnBuildArgs(self):
+        return self.argsOpt
+
+    def build_outputs(self):
+        extensions = ["out"]
+        if self.options.enable_link_map_file:
+            extensions.append("out.map")
+        for ext in extensions:
+            name = f"{self.app.AppNamePrefix('qcc74x')}.{ext}"
+            yield BuilderOutput(os.path.join(self.output_dir, name), name)
+
+    def PreBuildCommand(self):
+        os.system("rm -rf {}/config".format(self.output_dir))
+        os.system("rm -rf {}/ota_images".format(self.output_dir))
+        os.system("rm -rf {}".format(os.path.join(self.output_dir, 'boot2*.bin')))
+        os.system("rm -rf {}".format(os.path.join(self.output_dir, '%s*' % self.app.AppNamePrefix('qcc74x'))))
+
+    def PostBuildCommand(self):
+
+        abs_path_fw = os.path.join(self.output_dir, self.app.AppNamePrefix('qcc74x') + ".raw")
+
+        if os.path.isfile(abs_path_fw):
+            target_dir = self.output_dir.replace(self.chip_dir, "").strip("/")
+
+            path_fw = os.path.join(target_dir, self.app.AppNamePrefix('qcc74x') + ".bin")
+            path_flash_script = os.path.join(target_dir, self.app.AppNamePrefix('qcc74x') + ".flash.py")
+
+            logging.info('*' * 80)
+
+            logging.info("Firmware is built out at: {}".format(abs_path_fw))
+            logging.info("Command to generate ota image: ")
+            logging.info('./{} --build-ota --vendor-id <vendor id> --product-id <product id> '
+                         '--version <version> --version-str <version string> '
+                         '--digest-algorithm <digest algorithm>'.format(path_flash_script))
+            logging.info("Command to generate and sign ota image: ")
+            logging.info('./{} --build-ota --vendor-id <vendor id> --product-id <product id> '
+                         '--version <version> --version-str <version string> '
+                         '--digest-algorithm <digest algorithm> --sk <private key>'.format(path_flash_script))
+            logging.info('*' * 80)

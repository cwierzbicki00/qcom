+            }
+        },
+        "min-version": {
+            'help': 'minimum software version passes to ota_image_tool.py ota image if --build-ota present',
+            'default': None,
+            'argparse': {
+                'metavar': 'min_version',
+                "type": any_base_int
+            }
+        },
+        "max-version": {
+            'help': 'maximum software version passes to ota_image_tool.py ota image if --build-ota present',
+            'default': None,
+            'argparse': {
+                'metavar': 'max_version',
+                "type": any_base_int

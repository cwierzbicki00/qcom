+++ b/third_party/qualcomm/qcc74x/qcc74x_sdk.gni
@@ -0,0 +1,1341 @@
+# Copyright (c", 2021 Project CHIP Authors
+#
+# Licensed under the Apache License, Version 2.0 (the "License");

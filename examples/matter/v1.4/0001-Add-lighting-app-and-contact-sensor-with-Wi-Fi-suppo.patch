+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+import("//args.gni")
+import("//build_overrides/qcc74x_sdk.gni")
+import("//build_overrides/chip.gni")
+import("//build_overrides/mbedtls.gni")
+import("${chip_root}/src/lib/lib.gni")
+
+declare_args() {
+  chip_enable_factory_data = false
+
+  qcc74x_board = "qcc743dk"
+  qcc74x_sdk_boot2 = ""
+  qcc74x_sdk_dts = ""
+
+  enable_debug_coredump = false
+  coredump_binary_id = 0
+  qcc74x_sdk_coredump_version = 1
+}
+
+template("qcc74x_sdk") {
+
+  assert(invoker.qcc74x_board != "", "qcc74x_board must be specified")
+  assert(invoker.qcc74x_sdk_root != "", "qcc74x_sdk_root must be specified")
+  assert(invoker.qcc74x_sdk_toolchain != "", "qcc74x_sdk_toolchain must be specified")
+
+  qcc74x_sdk_root = invoker.qcc74x_sdk_root
+
+  sdk_target_name = target_name
+
+  config("${sdk_target_name}_config") {
+    defines = [
+      "QCC743=QCC743",
+      "ARCH_RISCV",
+    ]
+
+    include_dirs = []
+    if (defined(invoker.include_dirs)) {
+      include_dirs += invoker.include_dirs
+    }
+
+    if (defined(invoker.defines)) {
+      defines += invoker.defines
+    }
+
+    cflags_c = [
+      "-fno-jump-tables",
+      "-fstrict-volatile-bitfields",
+      "-fshort-enums",
+      "-Wno-unused-but-set-variable",
+    ]
+
+    cflags = [
+      "-Wno-conversion",
+      "-fstack-usage",
+    ]
+
+    if (defined(invoker.defines)) {
+      defines += invoker.defines
+    }
+  }
+
+  config("${sdk_target_name}_config_startup") {
+    include_dirs = [ "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup" ]
+  }
+
+  source_set("${sdk_target_name}_startup") {
+    defines = [
+      "ARCH_RISCV",
+      "QCC74x_USE_HAL_DRIVER",
+      "CONFIG_IRQ_NUM=80",
+    ]
+
+    if (defined(invoker.enable_debug_coredump) &&
+        invoker.enable_debug_coredump) {
+      defines += [ "CONFIG_COREDUMP" ]
+    }
+
+    include_dirs = [ "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup" ]
+
+    sources = [
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup/interrupt.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup/riscv_fpu.S",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup/start_load.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup/system_qcc743.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/startup/vector.S",
+    ]
+
+    configs += [
+      ":${sdk_target_name}_config_freertos",
+      ":${sdk_target_name}_config_std_drv",
+      ":${sdk_target_name}_config_lhal",
+      ":${sdk_target_name}_config_utils",
+    ]
+
+    public_configs = [
+      ":${sdk_target_name}_config",
+      ":${sdk_target_name}_config_startup",
+    ]
+  }
+
+  config("${sdk_target_name}_config_std_drv") {
+    include_dirs = [
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/include",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/include/hardware",
+    ]
+
+    defines = [
+      "ARCH_RISCV",
+      "QCC74x_USE_HAL_DRIVER",
+    ]
+
+    cflags = [ "-Wsign-compare" ]
+  }
+
+  source_set("${sdk_target_name}_std_drv") {
+    defines = [
+      "ARCH_RISCV",
+      "QCC74x_USE_HAL_DRIVER",
+      "QCC74x_USE_ROM_DRIVER",
+    ]
+
+    include_dirs = [
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/include",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/include/hardware",
+    ]
+
+    sources = [
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/port/qcc743_clock.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/port/qcc743_gpio.c",
+    ]
+
+    sources += [
+      #use rom api default
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_clock.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_common.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_ef_cfg.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_pm.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_psram.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_romapi_e907.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_romapi_patch.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_sdh.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_tzc_sec.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_mfg_efuse.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_mfg_flash.c",
+      "${qcc74x_sdk_root}/drivers/soc/qcc743/std/src/qcc743_mfg_media.c",
+    ]
+
+    cflags_c = [
+      "-Wno-sign-compare",
+      "-Wno-enum-conversion",
+      "-Wno-type-limits",
+      "-Wno-implicit-function-declaration"
+    ]
+
+    configs += [
+      ":${sdk_target_name}_config_startup",
+      ":${sdk_target_name}_config_lhal",
+      ":${sdk_target_name}_config_freertos",
+    ]
+    public_configs = [
+      ":${sdk_target_name}_config_std_drv",
+      ":${sdk_target_name}_config",
+    ]
+  }
+
+  config("${sdk_target_name}_config_lhal") {
+    include_dirs = [
+      "${qcc74x_sdk_root}/drivers/lhal/include",
+      "${qcc74x_sdk_root}/drivers/lhal/include/arch",

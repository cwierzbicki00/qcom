+CHIP_ERROR FactoryDataProvider::GetDeviceAttestationCert(MutableByteSpan & outBuffer)
+{
+    int len = 0;
+
+    len = mfd_getDacCert(outBuffer.data(), outBuffer.size());
+    if (len > 0)
+    {
+        outBuffer.reduce_size(len);
+        return CHIP_NO_ERROR;
+    }
+    else if (0 == len)

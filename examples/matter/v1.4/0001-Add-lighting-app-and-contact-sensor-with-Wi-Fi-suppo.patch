+
+import("//build_overrides/build.gni")
+import("//build_overrides/chip.gni")
+import("//build_overrides/qcc74x_sdk.gni")
+import("${build_root}/config/defaults.gni")
+
+import("${qcc74x_build_root}/qcc74x/qcc74x_sdk.gni")
+import("${qcc74x_build_root}/qcc74x/qcc74x_executable.gni")
+import("${chip_root}/src/platform/qualcomm/qcc74x/args.gni")
+
+import("${chip_root}/src/platform/device.gni")
+import("${chip_root}/src/app/chip_data_model.gni")
+
+assert(current_os == "freertos")
+
+example_dir = "${chip_root}/examples/contact-sensor-app/qualcomm"
+examples_plat_dir = "${chip_root}/examples/platform/qualcomm"
+
+declare_args() {
+  # Dump memory usage at link time.
+  chip_print_memory_usage = true
+
+  # OTA periodic query timeout in seconds
+  ota_periodic_query_timeout_seconds = 86400
+
+  # reboot delay in seconds to apply new OTA image
+  ota_auto_reboot_delay_seconds = 5
+
+  enable_heap_monitoring = false
+
+  setupPinCode = 20202021
+  setupDiscriminator = 3840
+}
+
+qcc74x_sdk("sdk") {
+  defines = [
+    "INCLUDE_xSemaphoreGetMutexHolder=1",
+    "CHIP_DEVICE_CONFIG_USE_TEST_SETUP_PIN_CODE=${setupPinCode}",
+    "CHIP_DEVICE_CONFIG_USE_TEST_SETUP_DISCRIMINATOR=${setupDiscriminator}",
+    "OTA_PERIODIC_TIMEOUT=${ota_periodic_query_timeout_seconds}",
+    "OTA_AUTO_REBOOT_DELAY=${ota_auto_reboot_delay_seconds}",
+    "CONFIG_BOOT2=0",
+  ]
+
+  defines += [ "configUSE_TICK_HOOK=0" ]
+
+  include_dirs = [
+    "${example_dir}/qcc74x",
+    "${examples_plat_dir}/qcc74x/plat",
+    "${chip_root}/src/platform/qualcomm/qcc74x",
+  ]
+
+  if (chip_enable_wifi) {
+    include_dirs += [ "${examples_plat_dir}/qcc74x/lwip" ]
+  }
+}
+
+qcc74x_executable("contact_sensor_app") {
+  output_name = "chip-qcc74x-contact-sensor-example.out"
+
+  defines = [
+    "APP_TASK_STACK_SIZE=4096",
+    "START_ENTRY=main",
+    "CONFIG_QCC74X_FACTORY_DATA_ENABLE=${chip_enable_factory_data}",
+  ]
+
+  defines += [ "configUSE_TICK_HOOK=0" ]
+
+  include_dirs = [
+    "${chip_root}/src/platform/qualcomm/qcc74x",
+    "${example_dir}/qcc74x",
+    "${examples_plat_dir}/qcc74x/plat",
+  ]
+
+  sources = [
+    "${chip_root}/examples/providers/DeviceInfoProviderImpl.cpp",
+    "${example_dir}/qcc74x/AppTask.cpp",
+    "${example_dir}/qcc74x/ZclCallbacks.cpp",
+    "${examples_plat_dir}/qcc74x/plat/platform_port.cpp",
+    "${examples_plat_dir}/qcc74x/plat/OTAConfig.cpp",
+    "${examples_plat_dir}/qcc74x/plat/main.cpp",
+    "${examples_plat_dir}/qcc74x/plat/platform.cpp",
+  ]
+
+  deps = [
+    ":sdk",
+    "${chip_root}/examples/contact-sensor-app/contact-sensor-common",
+    "${chip_root}/examples/providers:device_info_provider",
+    "${chip_root}/src/lib",
+    "${chip_root}/src/setup_payload",
+  ]
+
+  if (chip_enable_wifi) {
+    defines += [ "CHIP_DEVICE_CONFIG_ENABLE_WIFI" ]
+
+    include_dirs += [ "${examples_plat_dir}/qcc74x/lwip" ]
+    sources += [
+      "${examples_plat_dir}/qcc74x/lwip/qcc74x_route_hook.c",
+      "${examples_plat_dir}/qcc74x/lwip/qcc74x_route_table.c",
+    ]
+  }
+
+  defines += [ "CONFIG_ENABLE_CHIP_SHELL=${chip_build_libshell}" ]
+  if (chip_build_libshell) {
+    include_dirs += [
+      "${chip_root}/src/lib/shell",
+      "${chip_root}/examples/shell/shell_common/include",
+    ]
+
+    deps += [ "${chip_root}/examples/shell/shell_common:shell_common" ]
+  }
+
+  defines += [ "HEAP_MONITORING=${enable_heap_monitoring}" ]
+  if (enable_heap_monitoring) {
+    sources += [ "${examples_plat_dir}/qcc74x/plat/MemMonitoring.cpp" ]
+  }
+
+  cflags_c = [ "-Wno-sign-compare" ]
+
+  ldscript = "${qcc74x_sdk_root}/bsp/board/${qcc74x_board}/qcc743_flash.ld"
+  ldflags = [ "-T" + rebase_path(ldscript, root_build_dir) ]
+  ldflags += [
+    "--specs=nano.specs",
+    "-Wl,--print-memory-usage",
+    "-fstack-usage",
+  ]
+
+  inputs = [ ldscript ]
+  output_dir = root_out_dir
+}
+
+group("qcc74x") {
+  deps = [ ":contact_sensor_app" ]
+}
+
+group("default") {
+  deps = [ ":qcc74x" ]
+}
